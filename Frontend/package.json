{
  "name": "pixelace",
  "version": "1.0.0",
  "author": "Fatih Tirek",
  "private": true,
  "scripts": {
    "bundle-css": "tailwindcss -i ./src/main.css -o ./dist/output.css --minify",
    "bundle-js": "webpack",
    "watch-css": "tailwindcss -i ./src/main.css -o ./dist/output.css --watch",
    "watch-js": "webpack --watch",
    "dev": "concurrently --names \"CSS,JS\" --prefix-colors \"blue,green\" \"npm run watch-css\" \"npm run watch-js\""
  },
  "devDependencies": {
    "@microsoft/signalr": "^10.0.11",
    "@microsoft/signalr-protocol-msgpack": "^10.0.11",
    "concurrently": "^10.0.5",
    "tailwindcss": "^3.4.1",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "webpack": "^5.91.0"
  }
}
